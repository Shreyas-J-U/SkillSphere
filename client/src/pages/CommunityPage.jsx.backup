import { useState, useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";
import {
  MessageSquare,
  Heart,
  Send,
  Image as ImageIcon,
  MoreHorizontal,
  Share2,
  Users,
  TrendingUp,
  Sparkles,
  X,
  Award,
  Bookmark,
  Flag,
  Edit3,
  Trash2,
  ChevronDown,
  Filter,
  Search,
  Zap,
} from "lucide-react";

const COLORS = {
  gradientPrimary: "from-blue-600 via-purple-600 to-pink-500",
  accentLime: "#84cc16",
};

const CommunityPage = () => {
  const [user] = useState({
    _id: "user123",
    name: "Alex Rodriguez",
    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=Alex",
    skills: ["React", "Guitar", "Photography"],
  });

  const [posts, setPosts] = useState([
    {
      _id: "1",
      user: {
        _id: "user456",
        name: "Sarah Chen",
        avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=Sarah",
        badge: "Pro",
      },
      content:
        "Just completed my first skill swap! Taught Python and learned Guitar basics. The SkillSphere community is amazing! 🎸💻",
      image:
        "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=800&h=600&fit=crop&q=80",
      likes: ["user123", "user789"],
      comments: [
        {
          user: {
            name: "Mike Johnson",
            avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=Mike",
          },
          content: "That's awesome! I'm looking for Python lessons too!",
        },
      ],
      createdAt: new Date(Date.now() - 3600000).toISOString(),
      tags: ["Python", "Guitar", "Success"],
    },
    {
      _id: "2",
      user: {
        _id: "user789",
        name: "David Kim",
        avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=David",
        badge: "Elite",
      },
      content:
        "🚀 Looking for someone who can teach Calculus! I can offer help with Web Development (React, Node.js). Let's connect!",
      likes: ["user456"],
      comments: [],
      createdAt: new Date(Date.now() - 7200000).toISOString(),
      tags: ["Calculus", "WebDev", "Seeking"],
    },
  ]);

  const [newPostContent, setNewPostContent] = useState("");
  const [loading, setLoading] = useState(false);
  const [uploading, setUploading] = useState(false);
  const [selectedImage, setSelectedImage] = useState(null);
  const [commentingPostId, setCommentingPostId] = useState(null);
  const [commentContent, setCommentContent] = useState("");
  const [showFilters, setShowFilters] = useState(false);
  const [searchQuery, setSearchQuery] = useState("");
  const [selectedFilter, setSelectedFilter] = useState("all");
  const [showOptions, setShowOptions] = useState(null);

  const handleImageUpload = async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    setUploading(true);
    // Simulate upload
    setTimeout(() => {
      setSelectedImage(URL.createObjectURL(file));
      setUploading(false);
    }, 1500);
  };

  const handleCreatePost = async () => {
    if (!newPostContent.trim() && !selectedImage) return;

    const newPost = {
      _id: Date.now().toString(),
      user: user,
      content: newPostContent,
      image: selectedImage,
      likes: [],
      comments: [],
      createdAt: new Date().toISOString(),
      tags: [],
    };

    setPosts([newPost, ...posts]);
    setNewPostContent("");
    setSelectedImage(null);
  };

  const handleLike = (postId) => {
    setPosts(
      posts.map((post) =>
        post._id === postId
          ? {
              ...post,
              likes: post.likes.includes(user._id)
                ? post.likes.filter((id) => id !== user._id)
                : [...post.likes, user._id],
            }
          : post
      )
    );
  };

  const handleComment = (postId) => {
    if (!commentContent.trim()) return;

    setPosts(
      posts.map((post) =>
        post._id === postId
          ? {
              ...post,
              comments: [
                ...post.comments,
                {
                  user: { name: user.name, avatar: user.avatar },
                  content: commentContent,
                },
              ],
            }
          : post
      )
    );
    setCommentContent("");
  };

  const handleDeletePost = (postId) => {
    setPosts(posts.filter((post) => post._id !== postId));
    setShowOptions(null);
  };

  const filteredPosts = posts.filter((post) => {
    const matchesSearch =
      post.content.toLowerCase().includes(searchQuery.toLowerCase()) ||
      post.user.name.toLowerCase().includes(searchQuery.toLowerCase());
    const matchesFilter =
      selectedFilter === "all" ||
      (selectedFilter === "my-posts" && post.user._id === user._id) ||
      (selectedFilter === "popular" && post.likes.length > 1);
    return matchesSearch && matchesFilter;
  });

  return (
    <div className="min-h-screen bg-slate-50">
      {/* Enhanced Navbar */}
      <nav className="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-xl border-b border-slate-200/50 shadow-sm">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between items-center h-20">
            <div className="flex items-center gap-2 cursor-pointer group">
              <div
                className={`w-10 h-10 rounded-xl bg-gradient-to-br ${COLORS.gradientPrimary} flex items-center justify-center transform group-hover:rotate-12 transition-transform duration-300`}
              >
                <Zap className="text-white w-6 h-6" fill="currentColor" />
              </div>
              <span className="font-bold text-2xl tracking-tight text-slate-900">
                Skill
                <span className="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600">
                  Sphere
                </span>
              </span>
            </div>

            <div className="hidden md:flex items-center space-x-6">
              <a
                href="#"
                className="text-slate-600 hover:text-purple-600 font-medium transition-colors"
              >
                Dashboard
              </a>
              <a
                href="#"
                className="text-purple-600 font-semibold border-b-2 border-purple-600"
              >
                Community
              </a>
              <a
                href="#"
                className="text-slate-600 hover:text-purple-600 font-medium transition-colors"
              >
                Find Skills
              </a>
              <div className="flex items-center gap-3 ml-4">
                <div className="relative">
                  <div className="w-10 h-10 rounded-full bg-gradient-to-br from-blue-400 to-purple-600 p-0.5">
                    <img
                      src={user.avatar}
                      alt={user.name}
                      className="w-full h-full rounded-full border-2 border-white"
                    />
                  </div>
                  <div className="absolute -top-1 -right-1 w-4 h-4 bg-green-500 rounded-full border-2 border-white"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <div className="pt-24 pb-12">
        <div className="container mx-auto px-4 max-w-6xl">
          <div className="grid lg:grid-cols-12 gap-8">
            {/* Left Sidebar */}
            <div className="lg:col-span-3 space-y-6">
              {/* User Profile Card */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                className="bg-white rounded-2xl shadow-xl p-6 border-2 border-slate-100 sticky top-28"
              >
                <div className="text-center">
                  <div className="relative inline-block mb-4">
                    <div className="w-20 h-20 rounded-full bg-gradient-to-br from-blue-400 to-purple-600 p-1">
                      <img
                        src={user.avatar}
                        alt={user.name}
                        className="w-full h-full rounded-full border-2 border-white"
                      />
                    </div>
                    <div className="absolute -bottom-1 -right-1 w-7 h-7 bg-gradient-to-r from-blue-600 to-purple-600 rounded-full flex items-center justify-center border-2 border-white">
                      <Sparkles className="w-4 h-4 text-white" />
                    </div>
                  </div>
                  <h3 className="font-bold text-lg text-slate-900">
                    {user.name}
                  </h3>
                  <p className="text-sm text-slate-500 mb-4">@alexrodriguez</p>

                  <div className="flex justify-center gap-4 mb-4 text-sm">
                    <div>
                      <div className="font-bold text-slate-900">24</div>
                      <div className="text-slate-500 text-xs">Swaps</div>
                    </div>
                    <div className="border-l border-slate-200"></div>
                    <div>
                      <div className="font-bold text-slate-900">156</div>
                      <div className="text-slate-500 text-xs">Points</div>
                    </div>
                  </div>

                  <div className="space-y-2">
                    <div className="flex items-center justify-between text-sm">
                      <span className="text-slate-600">Level Progress</span>
                      <span className="font-bold text-purple-600">Level 3</span>
                    </div>
                    <div className="w-full bg-slate-100 rounded-full h-2">
                      <div
                        className="bg-gradient-to-r from-blue-600 to-purple-600 h-2 rounded-full"
                        style={{ width: "65%" }}
                      ></div>
                    </div>
                  </div>
                </div>

                <div className="mt-6 pt-6 border-t border-slate-100">
                  <h4 className="text-xs font-bold text-slate-400 uppercase mb-3">
                    My Skills
                  </h4>
                  <div className="flex flex-wrap gap-2">
                    {user.skills.map((skill, i) => (
                      <span
                        key={i}
                        className="px-3 py-1 bg-gradient-to-r from-blue-50 to-purple-50 text-purple-600 rounded-full text-xs font-semibold border border-purple-100"
                      >
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>
              </motion.div>

              {/* Trending Topics */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.1 }}
                className="bg-white rounded-2xl shadow-xl p-6 border-2 border-slate-100"
              >
                <div className="flex items-center gap-2 mb-4">
                  <TrendingUp className="w-5 h-5 text-purple-600" />
                  <h3 className="font-bold text-slate-900">Trending Topics</h3>
                </div>
                <div className="space-y-3">
                  {[
                    "#Python",
                    "#Guitar",
                    "#Calculus",
                    "#WebDev",
                    "#Design",
                  ].map((tag, i) => (
                    <button
                      key={i}
                      className="w-full text-left px-3 py-2 rounded-lg hover:bg-slate-50 transition-colors group"
                    >
                      <div className="flex items-center justify-between">
                        <span className="font-semibold text-slate-700 group-hover:text-purple-600">
                          {tag}
                        </span>
                        <span className="text-xs text-slate-400">
                          {Math.floor(Math.random() * 100)}+ posts
                        </span>
                      </div>
                    </button>
                  ))}
                </div>
              </motion.div>
            </div>

            {/* Main Content */}
            <div className="lg:col-span-6 space-y-6">
              {/* Search and Filters */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                className="bg-white rounded-2xl shadow-xl p-4 border-2 border-slate-100"
              >
                <div className="flex gap-3">
                  <div className="flex-1 relative">
                    <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" />
                    <input
                      type="text"
                      value={searchQuery}
                      onChange={(e) => setSearchQuery(e.target.value)}
                      placeholder="Search posts, people, skills..."
                      className="w-full pl-10 pr-4 py-3 bg-slate-50 rounded-xl border border-slate-200 focus:border-purple-500 focus:ring-2 focus:ring-purple-100 transition-all outline-none text-slate-600"
                    />
                  </div>
                  <button
                    onClick={() => setShowFilters(!showFilters)}
                    className={`px-4 py-3 rounded-xl border-2 transition-all ${
                      showFilters
                        ? "bg-purple-50 border-purple-500 text-purple-600"
                        : "border-slate-200 text-slate-600 hover:border-slate-300"
                    }`}
                  >
                    <Filter className="w-5 h-5" />
                  </button>
                </div>

                <AnimatePresence>
                  {showFilters && (
                    <motion.div
                      initial={{ height: 0, opacity: 0 }}
                      animate={{ height: "auto", opacity: 1 }}
                      exit={{ height: 0, opacity: 0 }}
                      className="mt-4 pt-4 border-t border-slate-100"
                    >
                      <div className="flex gap-2">
                        {[
                          { id: "all", label: "All Posts" },
                          { id: "my-posts", label: "My Posts" },
                          { id: "popular", label: "Popular" },
                        ].map((filter) => (
                          <button
                            key={filter.id}
                            onClick={() => setSelectedFilter(filter.id)}
                            className={`px-4 py-2 rounded-lg text-sm font-semibold transition-all ${
                              selectedFilter === filter.id
                                ? "bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-lg"
                                : "bg-slate-100 text-slate-600 hover:bg-slate-200"
                            }`}
                          >
                            {filter.label}
                          </button>
                        ))}
                      </div>
                    </motion.div>
                  )}
                </AnimatePresence>
              </motion.div>

              {/* Create Post Card */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.1 }}
                className="bg-white rounded-2xl shadow-xl p-6 border-2 border-slate-100"
              >
                <div className="flex space-x-4">
                  <div className="w-12 h-12 rounded-full bg-gradient-to-br from-blue-400 to-purple-600 p-0.5 flex-shrink-0">
                    <img
                      src={user.avatar}
                      alt={user.name}
                      className="w-full h-full rounded-full border-2 border-white"
                    />
                  </div>
                  <div className="flex-1">
                    <textarea
                      value={newPostContent}
                      onChange={(e) => setNewPostContent(e.target.value)}
                      placeholder="Share your learning journey, ask questions, or celebrate wins! 🎉"
                      className="w-full p-4 bg-slate-50 rounded-xl border-2 border-slate-200 focus:border-purple-500 focus:ring-2 focus:ring-purple-100 transition-all outline-none resize-none h-28 text-slate-700 placeholder:text-slate-400"
                    />

                    {selectedImage && (
                      <div className="relative mt-4 inline-block">
                        <img
                          src={selectedImage}
                          alt="Upload preview"
                          className="h-40 rounded-xl object-cover border-2 border-slate-200"
                        />
                        <button
                          onClick={() => setSelectedImage(null)}
                          className="absolute -top-2 -right-2 bg-red-500 text-white rounded-full p-2 hover:bg-red-600 transition-colors shadow-lg"
                        >
                          <X className="w-4 h-4" />
                        </button>
                      </div>
                    )}

                    <div className="flex justify-between items-center mt-4">
                      <label className="flex items-center space-x-2 text-slate-500 hover:text-purple-600 cursor-pointer transition-colors px-4 py-2 rounded-xl hover:bg-purple-50">
                        <ImageIcon size={20} />
                        <span className="text-sm font-semibold">Add Photo</span>
                        <input
                          type="file"
                          accept="image/*"
                          onChange={handleImageUpload}
                          className="hidden"
                          disabled={uploading}
                        />
                      </label>

                      <button
                        onClick={handleCreatePost}
                        disabled={
                          (!newPostContent.trim() && !selectedImage) ||
                          uploading
                        }
                        className="px-8 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl font-bold hover:shadow-xl transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
                      >
                        {uploading ? (
                          <div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        ) : (
                          <>
                            <Send size={18} />
                            Post
                          </>
                        )}
                      </button>
                    </div>
                  </div>
                </div>
              </motion.div>

              {/* Posts Feed */}
              <div className="space-y-6">
                <AnimatePresence>
                  {filteredPosts.map((post, index) => (
                    <motion.div
                      key={post._id}
                      initial={{ opacity: 0, y: 20 }}
                      animate={{ opacity: 1, y: 0 }}
                      exit={{ opacity: 0, scale: 0.95 }}
                      transition={{ delay: index * 0.1 }}
                      className="bg-white rounded-2xl shadow-xl border-2 border-slate-100 overflow-hidden hover:shadow-2xl transition-all"
                    >
                      {/* Post Header */}
                      <div className="p-6 flex items-center justify-between">
                        <div className="flex items-center space-x-3">
                          <div className="relative">
                            <div className="w-12 h-12 rounded-full bg-gradient-to-br from-blue-400 to-purple-600 p-0.5">
                              <img
                                src={post.user.avatar}
                                alt={post.user.name}
                                className="w-full h-full rounded-full border-2 border-white"
                              />
                            </div>
                            {post.user.badge && (
                              <div className="absolute -bottom-1 -right-1 w-6 h-6 bg-gradient-to-r from-yellow-400 to-orange-500 rounded-full flex items-center justify-center border-2 border-white">
                                <Award className="w-3 h-3 text-white" />
                              </div>
                            )}
                          </div>
                          <div>
                            <div className="flex items-center gap-2">
                              <h3 className="font-bold text-slate-900">
                                {post.user.name}
                              </h3>
                              {post.user.badge && (
                                <span className="px-2 py-0.5 bg-gradient-to-r from-yellow-400 to-orange-500 text-white text-xs font-bold rounded-full">
                                  {post.user.badge}
                                </span>
                              )}
                            </div>
                            <p className="text-xs text-slate-500">
                              {new Date(post.createdAt).toLocaleString(
                                "en-US",
                                {
                                  month: "short",
                                  day: "numeric",
                                  hour: "2-digit",
                                  minute: "2-digit",
                                }
                              )}
                            </p>
                          </div>
                        </div>
                        <div className="relative">
                          <button
                            onClick={() =>
                              setShowOptions(
                                showOptions === post._id ? null : post._id
                              )
                            }
                            className="text-slate-400 hover:text-slate-600 p-2 rounded-lg hover:bg-slate-50 transition-colors"
                          >
                            <MoreHorizontal size={20} />
                          </button>

                          <AnimatePresence>
                            {showOptions === post._id && (
                              <motion.div
                                initial={{ opacity: 0, scale: 0.95, y: -10 }}
                                animate={{ opacity: 1, scale: 1, y: 0 }}
                                exit={{ opacity: 0, scale: 0.95 }}
                                className="absolute right-0 top-full mt-2 w-48 bg-white rounded-xl shadow-2xl border border-slate-200 py-2 z-10"
                              >
                                {post.user._id === user._id ? (
                                  <>
                                    <button className="w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-slate-50 flex items-center gap-2">
                                      <Edit3 size={16} />
                                      Edit Post
                                    </button>
                                    <button
                                      onClick={() => handleDeletePost(post._id)}
                                      className="w-full px-4 py-2 text-left text-sm text-red-600 hover:bg-red-50 flex items-center gap-2"
                                    >
                                      <Trash2 size={16} />
                                      Delete Post
                                    </button>
                                  </>
                                ) : (
                                  <>
                                    <button className="w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-slate-50 flex items-center gap-2">
                                      <Bookmark size={16} />
                                      Save Post
                                    </button>
                                    <button className="w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-slate-50 flex items-center gap-2">
                                      <Flag size={16} />
                                      Report
                                    </button>
                                  </>
                                )}
                              </motion.div>
                            )}
                          </AnimatePresence>
                        </div>
                      </div>

                      {/* Post Content */}
                      <div className="px-6 pb-4">
                        <p className="text-slate-800 whitespace-pre-wrap leading-relaxed mb-4">
                          {post.content}
                        </p>
                        {post.tags && post.tags.length > 0 && (
                          <div className="flex flex-wrap gap-2 mb-4">
                            {post.tags.map((tag, i) => (
                              <span
                                key={i}
                                className="px-3 py-1 bg-purple-50 text-purple-600 rounded-full text-xs font-semibold border border-purple-100"
                              >
                                #{tag}
                              </span>
                            ))}
                          </div>
                        )}
                        {post.image && (
                          <img
                            src={post.image}
                            alt="Post content"
                            className="w-full rounded-xl max-h-[500px] object-cover border-2 border-slate-100"
                          />
                        )}
                      </div>

                      {/* Post Actions */}
                      <div className="px-6 py-4 bg-slate-50 flex items-center justify-between border-t-2 border-slate-100">
                        <div className="flex space-x-6">
                          <button
                            onClick={() => handleLike(post._id)}
                            className={`flex items-center space-x-2 transition-all group ${
                              post.likes.includes(user._id)
                                ? "text-red-500"
                                : "text-slate-500 hover:text-red-500"
                            }`}
                          >
                            <div className="relative">
                              <Heart
                                size={22}
                                fill={
                                  post.likes.includes(user._id)
                                    ? "currentColor"
                                    : "none"
                                }
                                className="group-hover:scale-110 transition-transform"
                              />
                              {post.likes.includes(user._id) && (
                                <motion.div
                                  initial={{ scale: 0 }}
                                  animate={{ scale: [0, 1.5, 1] }}
                                  className="absolute inset-0"
                                >
                                  <Heart
                                    size={22}
                                    className="text-red-500"
                                    fill="currentColor"
                                  />
                                </motion.div>
                              )}
                            </div>
                            <span className="font-bold">
                              {post.likes.length}
                            </span>
                          </button>

                          <button
                            onClick={() =>
                              setCommentingPostId(
                                commentingPostId === post._id ? null : post._id
                              )
                            }
                            className="flex items-center space-x-2 text-slate-500 hover:text-blue-600 transition-colors group"
                          >
                            <MessageSquare
                              size={22}
                              className="group-hover:scale-110 transition-transform"
                            />
                            <span className="font-bold">
                              {post.comments.length}
                            </span>
                          </button>

                          <button className="flex items-center space-x-2 text-slate-500 hover:text-green-600 transition-colors group">
                            <Share2
                              size={22}
                              className="group-hover:scale-110 transition-transform"
                            />
                          </button>
                        </div>

                        <button className="text-slate-400 hover:text-purple-600 transition-colors">
                          <Bookmark size={20} />
                        </button>
                      </div>

                      {/* Comments Section */}
                      <AnimatePresence>
                        {commentingPostId === post._id && (
                          <motion.div
                            initial={{ height: 0, opacity: 0 }}
                            animate={{ height: "auto", opacity: 1 }}
                            exit={{ height: 0, opacity: 0 }}
                            className="bg-slate-50 border-t-2 border-slate-100"
                          >
                            <div className="p-6 space-y-4">
                              {post.comments.map((comment, idx) => (
                                <motion.div
                                  key={idx}
                                  initial={{ opacity: 0, x: -20 }}
                                  animate={{ opacity: 1, x: 0 }}
                                  transition={{ delay: idx * 0.1 }}
                                  className="flex space-x-3"
                                >
                                  <img
                                    src={comment.user.avatar}
                                    alt={comment.user.name}
                                    className="w-10 h-10 rounded-full border-2 border-white shadow-md"
                                  />
                                  <div className="bg-white p-4 rounded-2xl rounded-tl-none shadow-md flex-1 border border-slate-100">
                                    <p className="font-bold text-sm text-slate-900 mb-1">
                                      {comment.user.name}
                                    </p>
                                    <p className="text-slate-700 text-sm leading-relaxed">
                                      {comment.content}
                                    </p>
                                  </div>
                                </motion.div>
                              ))}

                              <div className="flex items-center space-x-3 mt-6 pt-4 border-t border-slate-200">
                                <img
                                  src={user.avatar}
                                  alt={user.name}
                                  className="w-10 h-10 rounded-full border-2 border-purple-200"
                                />
                                <input
                                  type="text"
                                  value={commentContent}
                                  onChange={(e) =>
                                    setCommentContent(e.target.value)
                                  }
                                  placeholder="Write a thoughtful comment..."
                                  className="flex-1 px-4 py-3 bg-white border-2 border-slate-200 text-slate-700 rounded-full focus:border-purple-500 focus:ring-2 focus:ring-purple-100 transition-all outline-none text-sm"
                                  onKeyDown={(e) => {
                                    if (e.key === "Enter")
                                      handleComment(post._id);
                                  }}
                                />
                                <button
                                  onClick={() => handleComment(post._id)}
                                  disabled={!commentContent.trim()}
                                  className="p-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-full hover:shadow-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                                >
                                  <Send size={18} />
                                </button>
                              </div>
                            </div>
                          </motion.div>
                        )}
                      </AnimatePresence>
                    </motion.div>
                  ))}
                </AnimatePresence>

                {filteredPosts.length === 0 && (
                  <motion.div
                    initial={{ opacity: 0 }}
                    animate={{ opacity: 1 }}
                    className="text-center py-16"
                  >
                    <div className="w-24 h-24 mx-auto mb-6 bg-slate-100 rounded-full flex items-center justify-center">
                      <MessageSquare className="w-12 h-12 text-slate-400" />
                    </div>
                    <h3 className="text-xl font-bold text-slate-900 mb-2">
                      No posts found
                    </h3>
                    <p className="text-slate-600">
                      Try adjusting your filters or search query
                    </p>
                  </motion.div>
                )}
              </div>
            </div>

            {/* Right Sidebar */}
            <div className="lg:col-span-3 space-y-6">
              {/* Suggested Connections */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.2 }}
                className="bg-white rounded-2xl shadow-xl p-6 border-2 border-slate-100 sticky top-28"
              >
                <div className="flex items-center gap-2 mb-6">
                  <Users className="w-5 h-5 text-purple-600" />
                  <h3 className="font-bold text-slate-900">
                    Suggested Connections
                  </h3>
                </div>
                <div className="space-y-4">
                  {[
                    {
                      name: "Emma Watson",
                      avatar:
                        "https://api.dicebear.com/7.x/avataaars/svg?seed=Emma",
                      skills: ["French", "Marketing"],
                      compatibility: 95,
                    },
                    {
                      name: "John Smith",
                      avatar:
                        "https://api.dicebear.com/7.x/avataaars/svg?seed=John",
                      skills: ["Calculus", "Physics"],
                      compatibility: 88,
                    },
                    {
                      name: "Lisa Park",
                      avatar:
                        "https://api.dicebear.com/7.x/avataaars/svg?seed=Lisa",
                      skills: ["Design", "UI/UX"],
                      compatibility: 92,
                    },
                  ].map((person, i) => (
                    <div
                      key={i}
                      className="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 transition-all group"
                    >
                      <div className="relative">
                        <img
                          src={person.avatar}
                          alt={person.name}
                          className="w-12 h-12 rounded-full border-2 border-slate-200 group-hover:border-purple-300 transition-colors"
                        />
                        <div className="absolute -bottom-1 -right-1 w-6 h-6 bg-gradient-to-r from-green-400 to-emerald-500 rounded-full flex items-center justify-center text-xs font-bold text-white border-2 border-white">
                          {person.compatibility}
                        </div>
                      </div>
                      <div className="flex-1 min-w-0">
                        <h4 className="font-bold text-sm text-slate-900 truncate">
                          {person.name}
                        </h4>
                        <p className="text-xs text-slate-500 truncate">
                          {person.skills.join(" • ")}
                        </p>
                      </div>
                      <button className="px-3 py-1 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg text-xs font-bold hover:shadow-lg transition-all opacity-0 group-hover:opacity-100">
                        Connect
                      </button>
                    </div>
                  ))}
                </div>
                <button className="w-full mt-4 py-3 text-purple-600 font-semibold text-sm hover:bg-purple-50 rounded-xl transition-all">
                  View All Suggestions
                </button>
              </motion.div>

              {/* Community Stats */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.3 }}
                className="bg-gradient-to-br from-blue-600 via-purple-600 to-pink-500 rounded-2xl shadow-xl p-6 text-white"
              >
                <div className="flex items-center gap-2 mb-6">
                  <Sparkles className="w-5 h-5" />
                  <h3 className="font-bold">Community Impact</h3>
                </div>
                <div className="space-y-4">
                  <div>
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-white/80 text-sm">This Week</span>
                      <span className="font-bold">2,847</span>
                    </div>
                    <div className="w-full bg-white/20 rounded-full h-2">
                      <div
                        className="bg-white h-2 rounded-full"
                        style={{ width: "75%" }}
                      ></div>
                    </div>
                  </div>
                  <div className="grid grid-cols-2 gap-4 pt-4 border-t border-white/20">
                    <div>
                      <div className="text-2xl font-black">156</div>
                      <div className="text-white/80 text-xs">Active Swaps</div>
                    </div>
                    <div>
                      <div className="text-2xl font-black">89%</div>
                      <div className="text-white/80 text-xs">Success Rate</div>
                    </div>
                  </div>
                </div>
              </motion.div>

              {/* Quick Actions */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.4 }}
                className="bg-white rounded-2xl shadow-xl p-6 border-2 border-slate-100"
              >
                <h3 className="font-bold text-slate-900 mb-4">Quick Actions</h3>
                <div className="space-y-3">
                  <button className="w-full py-3 px-4 bg-gradient-to-r from-blue-50 to-purple-50 hover:from-blue-100 hover:to-purple-100 text-purple-600 rounded-xl font-semibold transition-all flex items-center gap-3 group">
                    <div className="w-10 h-10 bg-gradient-to-r from-blue-600 to-purple-600 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                      <Zap className="w-5 h-5 text-white" />
                    </div>
                    <span className="text-left flex-1">Find a Match</span>
                  </button>
                  <button className="w-full py-3 px-4 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded-xl font-semibold transition-all flex items-center gap-3 group">
                    <div className="w-10 h-10 bg-slate-200 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                      <Users className="w-5 h-5 text-slate-600" />
                    </div>
                    <span className="text-left flex-1">Browse Skills</span>
                  </button>
                  <button className="w-full py-3 px-4 bg-slate-50 hover:bg-slate-100 text-slate-700 rounded-xl font-semibold transition-all flex items-center gap-3 group">
                    <div className="w-10 h-10 bg-slate-200 rounded-lg flex items-center justify-center group-hover:scale-110 transition-transform">
                      <Award className="w-5 h-5 text-slate-600" />
                    </div>
                    <span className="text-left flex-1">View Achievements</span>
                  </button>
                </div>
              </motion.div>

              {/* Upcoming Events */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.5 }}
                className="bg-white rounded-2xl shadow-xl p-6 border-2 border-slate-100"
              >
                <h3 className="font-bold text-slate-900 mb-4">
                  Upcoming Events
                </h3>
                <div className="space-y-4">
                  {[
                    {
                      title: "Web Dev Workshop",
                      date: "Tomorrow, 3 PM",
                      attendees: 24,
                      color: "from-blue-500 to-blue-600",
                    },
                    {
                      title: "Language Exchange",
                      date: "Dec 28, 5 PM",
                      attendees: 18,
                      color: "from-purple-500 to-purple-600",
                    },
                    {
                      title: "Design Meetup",
                      date: "Dec 30, 2 PM",
                      attendees: 32,
                      color: "from-pink-500 to-pink-600",
                    },
                  ].map((event, i) => (
                    <div
                      key={i}
                      className="p-4 rounded-xl border-2 border-slate-100 hover:border-purple-200 hover:shadow-md transition-all group cursor-pointer"
                    >
                      <div className="flex items-start gap-3">
                        <div
                          className={`w-12 h-12 bg-gradient-to-br ${event.color} rounded-lg flex items-center justify-center text-white font-bold text-lg group-hover:scale-110 transition-transform`}
                        >
                          {event.date.split(",")[0].slice(0, 2)}
                        </div>
                        <div className="flex-1">
                          <h4 className="font-bold text-slate-900 mb-1">
                            {event.title}
                          </h4>
                          <p className="text-xs text-slate-500 mb-2">
                            {event.date}
                          </p>
                          <div className="flex items-center gap-2 text-xs text-slate-600">
                            <Users className="w-3 h-3" />
                            <span>{event.attendees} attending</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </motion.div>
            </div>
          </div>
        </div>
      </div>

      {/* Floating Action Button */}
      <motion.button
        initial={{ scale: 0 }}
        animate={{ scale: 1 }}
        transition={{ delay: 0.5, type: "spring" }}
        className="fixed bottom-8 right-8 w-16 h-16 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-full shadow-2xl hover:shadow-purple-500/50 hover:scale-110 transition-all flex items-center justify-center z-50 group"
        whileHover={{ rotate: 90 }}
      >
        <Edit3 className="w-6 h-6 group-hover:scale-110 transition-transform" />
      </motion.button>

      {/* Loading Overlay */}
      <AnimatePresence>
        {loading && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            className="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-[100]"
          >
            <div className="bg-white rounded-2xl p-8 shadow-2xl">
              <div className="w-16 h-16 border-4 border-purple-600 border-t-transparent rounded-full animate-spin mx-auto"></div>
              <p className="mt-4 text-slate-600 font-semibold">
                Loading community...
              </p>
            </div>
          </motion.div>
        )}
      </AnimatePresence>

      {/* Toast Notifications would go here */}
    </div>
  );
};

export default CommunityPage;
