        </div>
      </section>

      {/* Stats Section */}
      <section ref={statsRef} id="stats" className="py-20 px-6">
        <div className="max-w-7xl mx-auto">
          <div className={`grid md:grid-cols-4 gap-8 transition-all duration-1000 ${isVisible.stats ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-10'}`}>
            {[
              { number: '10K+', label: 'Active Users', icon: Users, color: 'from-blue-500 to-blue-600' },
              { number: '500+', label: 'Skills Available', icon: TrendingUp, color: 'from-purple-500 to-purple-600' },
              { number: '25K+', label: 'Successful Exchanges', icon: Award, color: 'from-indigo-500 to-indigo-600' },
              { number: '98%', label: 'Satisfaction Rate', icon: Star, color: 'from-pink-500 to-pink-600' }
