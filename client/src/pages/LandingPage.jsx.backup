              </div>
              <div className="p-8">
                <h3 className="text-2xl font-bold text-gray-900 mb-4">Our Mission</h3>
                <p className="text-gray-600 leading-relaxed">
                  To democratize learning by creating a global platform where knowledge is freely exchanged, 
                  barriers are broken, and every individual can unlock their potential through meaningful skill collaboration.
                </p>
              </div>
            </div>

            <div className="bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 border border-gray-100">
              <div className="relative h-64">
